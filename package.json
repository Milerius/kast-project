{
  "name": "kast-project",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.17"
  },
  "scripts": {
    "build": "pnpm -r --filter=!integration-tests --filter=!scenario-tests build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --filter=!integration-tests test",
    "test:unit": "pnpm --filter='./packages/*' test",
    "test:property": "pnpm --filter verify test",
    "test:bdd": "pnpm --filter scenario-tests test",
    "test:integration": "pnpm --filter integration-tests test",
    "test:smoke": "pnpm --filter @kast/web exec playwright test",
    "test:mutation": "pnpm --filter orchestrator exec stryker run",
    "dev": "pnpm --filter @kast/web dev",
    "sim:e2e": "tsx scripts/e2e-sim.ts"
  },
  "devDependencies": {
    "@eslint/compat": "1.2.3",
    "@eslint/js": "9.13.0",
    "@typescript-eslint/eslint-plugin": "8.12.2",
    "@typescript-eslint/parser": "8.12.2",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "9.13.0",
    "eslint-config-next": "15.0.2",
    "eslint-config-prettier": "9.1.0",
    "fast-check": "3.23.1",
    "prettier": "3.3.3",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "typescript-eslint": "8.12.2",
    "vitest": "2.1.9"
  },
  "pnpm": {
    "overrides": {
      "axios": ">=0.30.3",
      "@coinbase/wallet-sdk": ">=4.3.0",
      "vitest": "^2.1.9",
      "@vitest/coverage-v8": "^2.1.9",
      "esbuild": ">=0.25.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-3gc7-fjrx-p6mg"
      ]
    }
  }
}
